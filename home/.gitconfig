[include]
	# Does not work until 2.13
	path = .gitconfig.common
[push]
	# Default as of 2.0 - but sometimes we end up with old versions
	default = simple
[core]
	# Some basic options we want if includes aren't working
	excludesfile = ~/global.gitignore
	preloadindex = true
